{
  "name": "omni-comment-scraper",
  "version": "0.1.0",
  "description": "Omni-Platform Social Comment Scraper (Instagram, Facebook, YouTube, TikTok, Telegram, etc.) conforming to AI-SDLC Framework",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/validate-task-ids.mjs",
    "validate:tasks": "node scripts/validate-task-ids.mjs",
    "dashboard": "npx tsx scripts/serve-dashboard.ts",
    "demo:live": "npx tsx scripts/demo-live.ts",
    "demo:knowledge-lab": "npx tsx scripts/demo-knowledge-lab.ts",
    "eval:task": "node evals/harness.mjs --task task-001",
    "eval:task:002": "node evals/harness.mjs --task task-002",
    "scrape": "npx tsx src/cli/index.ts"
  },
  "keywords": [
    "scraper",
    "comments",
    "instagram",
    "facebook",
    "youtube",
    "tiktok",
    "telegram",
    "ai-sdlc"
  ],
  "author": "TrautsLab",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
