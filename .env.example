# ==========================================
# Omni-Platform Comment Scraper Credentials
# ==========================================

# Port for Mission Control Observability Dashboard
PORT=3333

# Instagram Credentials (Required for deep comment scraping)
# Extract 'sessionid' from your browser cookies when logged in to Instagram
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=

# YouTube Data API v3 (Optional, for higher quota official API)
# Public comments work without API key via fallback parser
YOUTUBE_API_KEY=

# Facebook (Optional session cookie for protected groups/pages)
FACEBOOK_C_USER=
FACEBOOK_XS=

# Telegram (Optional Bot token or MTProto API credentials)
# Public channel comments are scraped via web preview without credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# TikTok (Optional session cookie for rate-limited endpoints)
TIKTOK_SESSION_ID=
